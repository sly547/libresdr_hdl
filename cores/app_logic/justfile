set shell := ["bash", "-c"]

vivado_path := "/mnt/ssd/tools/Xilinx/2025.2/Vivado/settings64.sh"
core_name := "app_logic"

module:
    #!/usr/bin/env bash
    source ../../../venv_peakrdl/bin/activate
    echo "Python is $(which python)"
    peakrdl regblock module.rdl -o regblock/ --cpuif axi4-lite-flat

ip:
    #!/usr/bin/env bash
    echo "creating IP"
    source {{vivado_path}}
    vivado -mode batch -source ../../scripts/core.tcl -tclargs {{core_name}}
